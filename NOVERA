-- KEY CAPTURE
local WaitingForKey = nil
local Sending = false

local function SetStatus(message, color)
    Status.Text = message
    Status.TextColor3 = color or BLUE
end

local function GetCommandById(id)
    for _, command in ipairs(Commands) do
        if command.Id == id then
            return command
        end
    end
end

local function KeyAlreadyUsed(key, currentId)
    for id, assignedKey in pairs(Bindings) do
        if id ~= currentId and assignedKey == key then
            return id
        end
    end
end

-- CHAT CHANNEL
local function GetChannel()
    local channels = TextChatService:FindFirstChild("TextChannels")

    if not channels then
        return nil
    end

    return channels:FindFirstChild("RBXGeneral")
        or channels:FindFirstChildWhichIsA("TextChannel")
end

-- SEND COMMAND
local function SendCommand(command)
    if Sending then
        return
    end

    Sending = true

    task.spawn(function()
        local channel = GetChannel()

        if not channel then
            SetStatus("CHAT INDISPONIVEL", Color3.fromRGB(255, 100, 100))
            Sending = false
            return
        end

        for i = 1, command.Repetitions do
            local success, err = pcall(function()
                channel:SendAsync(command.Message)
            end)

            if not success then
                warn("[NOVERA] Chat error:", err)
                SetStatus("FALHA NO ENVIO", Color3.fromRGB(255, 100, 100))
                break
            end

            SetStatus(
                command.Name .. "  " .. i .. "/" .. command.Repetitions,
                BLUE
            )

            if i < command.Repetitions then
                task.wait(CONFIG.SendInterval)
            end
        end

        task.wait(1)
        SetStatus("SYSTEM ONLINE")
        Sending = false
    end)
end

