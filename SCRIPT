--==================================================
-- ESP SYSTEM
--==================================================

local function RemoveESP(player)
    local objects = ESPObjects[player]

    if objects then
        if objects.Highlight then
            objects.Highlight:Destroy()
        end

        if objects.Billboard then
            objects.Billboard:Destroy()
        end

        ESPObjects[player] = nil
    end
end

local function SetupESP(player)
    if player == LocalPlayer then return end

    RemoveESP(player)

    local character = player.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local head = character:FindFirstChild("Head")

    if not humanoid or not head then return end

    -- Outline

    local Highlight = Instance.new("Highlight")
    Highlight.Name = "BUILD06_Outline"
    Highlight.Adornee = character
    Highlight.FillTransparency = 1
    Highlight.OutlineColor = CONFIG.ESPColor
    Highlight.OutlineTransparency = 0
    Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    Highlight.Parent = character

    -- Name and Distance

    local Billboard = Instance.new("BillboardGui")
    Billboard.Name = "BUILD06_Identification"
    Billboard.Adornee = head
    Billboard.Size = UDim2.fromOffset(190, 42)
    Billboard.StudsOffset = Vector3.new(0, 2.5, 0)
    Billboard.AlwaysOnTop = true
    Billboard.Parent = PlayerGui

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.fromScale(1, 1)
    Label.BackgroundTransparency = 1
    Label.TextColor3 = CONFIG.ESPColor
    Label.TextStrokeTransparency = 0.3
    Label.TextSize = 13
    Label.Font = Enum.Font.GothamBold
    Label.Text = player.Name
    Label.Parent = Billboard

    ESPObjects[player] = {
        Highlight = Highlight,
        Billboard = Billboard,
        Label = Label
    }
end

local function UpdateESP()
    local myCharacter = LocalPlayer.Character
    local myRoot = myCharacter and myCharacter:FindFirstChild("HumanoidRootPart")

    if not myRoot then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local character = player.Character
            local root = character and character:FindFirstChild("HumanoidRootPart")
            local objects = ESPObjects[player]

            if character and root then
                if not objects then
                    SetupESP(player)
                    objects = ESPObjects[player]
                end

                if objects then
                    local distance = (myRoot.Position - root.Position).Magnitude
                    local visible = Enabled and distance <= CONFIG.MaxDistance

                    objects.Highlight.Enabled = visible
                    objects.Billboard.Enabled = visible

                    if objects.Label then
                        objects.Label.Text = string.format(
                            "%s\n%dm",
                            player.Name,
                            math.floor(distance)
                        )
                    end
                end
            else
                RemoveESP(player)
            end
        end
    end
end

