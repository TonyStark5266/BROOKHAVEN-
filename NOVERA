local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TextChatService = game:GetService("TextChatService")

local Player = Players.LocalPlayer

local CONFIG = {
    RepeatDelay = 0.2
}

local Commands = {
    [Enum.KeyCode.V] = {
        Name = "TIRO NA CARA",
        Message = "/tiro na cara",
        Repetitions = 1
    },

    [Enum.KeyCode.R] = {
        Name = "RENDER",
        Message = "/render",
        Repetitions = 3
    },

    [Enum.KeyCode.F] = {
        Name = "FACADA",
        Message = "/facada",
        Repetitions = 3
    },

    [Enum.KeyCode.B] = {
        Name = "TIRO NO PNEU",
        Message = "/tiro no pneu",
        Repetitions = 3
    },

    [Enum.KeyCode.P] = {
        Name = "PD",
        Message = "/pd",
        Repetitions = 1
    }
}

local Busy = false

local function GetChannel()
    local channels = TextChatService:FindFirstChild("TextChannels")

    if not channels then
        return nil
    end

    return channels:FindFirstChild("RBXGeneral")
end

local function ExecuteCommand(command)
    if Busy then
        return
    end

    Busy = true

    task.spawn(function()
        local channel = GetChannel()

        if not channel then
            warn("[NOVERA] Canal de chat indisponível.")
            Busy = false
            return
        end

        for i = 1, command.Repetitions do
            local success, err = pcall(function()
                channel:SendAsync(command.Message)
            end)

            if not success then
                warn("[NOVERA] Erro:", err)
                break
            end

            if i < command.Repetitions then
                task.wait(CONFIG.RepeatDelay)
            end
        end

        Busy = false
    end)
end

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then
        return
    end

    if UserInputService:GetFocusedTextBox() then
        return
    end

    local command = Commands[input.KeyCode]

    if command then
        ExecuteCommand(command)
        print("[NOVERA] Executando:", command.Name)
    end
end)

print("[NOVERA] Keyboard System online.")
print("[NOVERA] V | R | F | B | P")
