-- INPUT MANAGER
UIS.InputBegan:Connect(function(input, gameProcessed)

    -- CAPTURE NEW KEY
    if WaitingForKey then

        if input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end

        local key = input.KeyCode

        if key == Enum.KeyCode.Unknown then
            return
        end

        if key == Enum.KeyCode.Escape then
            WaitingForKey = nil
            Instruction.Text = "Selecione ALTERAR e pressione uma tecla."
            SetStatus("ALTERACAO CANCELADA")
            return
        end

        local conflict = KeyAlreadyUsed(
            key,
            WaitingForKey.Id
        )

        if conflict then
            SetStatus("TECLA JA UTILIZADA", Color3.fromRGB(255, 150, 70))
            return
        end

        local id = WaitingForKey.Id
        Bindings[id] = key

        WaitingForKey.Label.Text = key.Name
        WaitingForKey = nil

        Instruction.Text = "Selecione ALTERAR e pressione uma tecla."
        SetStatus("ATALHO ATUALIZADO")

        return
    end

    -- NORMAL KEYBIND EXECUTION
    if gameProcessed then
        return
    end

    if UIS:GetFocusedTextBox() then
        return
    end

    if not Main.Visible then
        -- Atalhos continuam ativos com painel fechado.
    end

    for id, key in pairs(Bindings) do
        if input.KeyCode == key then
            local command = GetCommandById(id)

            if command then
                SendCommand(command)
            end

            return
        end
    end
end)

