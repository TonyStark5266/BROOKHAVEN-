-- CANAL DE CHAT
local function GetChatChannel()
    local config = TextChatService:FindFirstChildOfClass(
        "ChatInputBarConfiguration"
    )

    if config and config.TargetTextChannel then
        return config.TargetTextChannel
    end

    local channels = TextChatService:FindFirstChild("TextChannels")

    if channels then
        return channels:FindFirstChild("RBXGeneral")
    end

    return nil
end

local Sending = false

local function SendCommand(command)
    if Sending then
        return
    end

    Sending = true

    task.spawn(function()
        local success = true

        for i = 1, command.Repetitions do
            local channel = GetChatChannel()

            if not channel then
                success = false
                break
            end

            local sent = pcall(function()
                channel:SendAsync(command.Message)
            end)

            if not sent then
                success = false
                break
            end

            if i < command.Repetitions then
                task.wait(CONFIG.RepeatDelay)
            end
        end

        Status.Text = success and "COMANDO ENVIADO" or "ERRO NO CHAT"
        Status.TextColor3 = success
            and Color3.fromRGB(80, 220, 150)
            or Color3.fromRGB(255, 100, 100)

        task.wait(1.5)
        Status.Text = "SISTEMA ONLINE"
        Status.TextColor3 = CONFIG.Accent

        Sending = false
    end)
end

