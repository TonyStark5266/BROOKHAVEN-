--==================================================
-- ATALHOS
--==================================================

UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or UIS:GetFocusedTextBox() then
        return
    end

    if WaitingForKey then
        if input.KeyCode == Enum.KeyCode.Escape then
            WaitingForKey = nil
            status.Text = "ALTERAÇÃO CANCELADA"
            return
        end

        if input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end

        for _, command in ipairs(Commands) do
            if command ~= WaitingForKey and command.Key == input.KeyCode then
                status.Text = "TECLA JÁ UTILIZADA"
                return
            end
        end

        WaitingForKey.Key = input.KeyCode
        KeyLabels[WaitingForKey].Text = input.KeyCode.Name
        WaitingForKey = nil
        status.Text = "ATALHO ATUALIZADO"
        return
    end

    for _, command in ipairs(Commands) do
        if input.KeyCode == command.Key then
            ExecuteCommand(command)
            return
        end
    end
end)

