-- CHAT CHANNEL

local function GetChannel()
    local config = TextChatService:FindFirstChildOfClass(
        "ChatInputBarConfiguration"
    )

    if config and config.TargetTextChannel then
        return config.TargetTextChannel
    end

    local channels = TextChatService:FindFirstChild("TextChannels")

    if channels then
        return channels:FindFirstChild("RBXGeneral")
            or channels:FindFirstChildWhichIsA("TextChannel")
    end

    return nil
end

-- COMMAND EXECUTION
-- Envios sujeitos aos controles oficiais do Roblox.

local function ExecuteCommand(command)
    task.spawn(function()
        local channel = GetChannel()

        if not channel then
            SetStatus("CHAT INDISPONIVEL", Color3.fromRGB(255, 90, 90))
            return
        end

        local successful = 0

        for i = 1, command.Repetitions do
            local success = pcall(function()
                channel:SendAsync(command.Message)
            end)

            if success then
                successful += 1
            else
                warn("[NOVERA] Envio recusado pelo chat.")
                break
            end
        end

        if successful == command.Repetitions then
            SetStatus(command.Name .. " | SOLICITADO",
                Color3.fromRGB(80, 220, 150))
        else
            SetStatus("ENVIO PARCIAL OU RECUSADO",
                Color3.fromRGB(255, 150, 70))
        end
    end)
end

-- KEY CONFIGURATION

local WaitingForKey = nil

local function IsKeyUsed(key, currentId)
    for id, assignedKey in pairs(Bindings) do
        if id ~= currentId and assignedKey == key then
            return true
        end
    end
    return false
end

