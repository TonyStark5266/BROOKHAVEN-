-- KEYBOARD INPUT

UIS.InputBegan:Connect(function(input, gameProcessed)

    if WaitingForKey then
        if input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end

        local key = input.KeyCode

        if key == Enum.KeyCode.Unknown then return end

        if key == Enum.KeyCode.Escape then
            WaitingForKey = nil
            Instruction.Text = "COMMAND CENTER | CONFIGURAR ATALHOS"
            SetStatus("ALTERACAO CANCELADA")
            return
        end

        if IsKeyUsed(key, WaitingForKey.Id) then
            SetStatus("TECLA JA UTILIZADA",
                Color3.fromRGB(255, 150, 70))
            return
        end

        Bindings[WaitingForKey.Id] = key
        WaitingForKey.Label.Text = key.Name

        WaitingForKey = nil
        Instruction.Text = "COMMAND CENTER | CONFIGURAR ATALHOS"
        SetStatus("ATALHO ATUALIZADO")
        return
    end

    if gameProcessed or UIS:GetFocusedTextBox() then
        return
    end

    for _, command in ipairs(Commands) do
        if input.KeyCode == Bindings[command.Id] then
            ExecuteCommand(command)
            return
        end
    end
end)

