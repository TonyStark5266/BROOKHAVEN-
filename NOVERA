local function GetChannel()
    local config = TextChatService:FindFirstChildOfClass("ChatInputBarConfiguration")

    if config and config.TargetTextChannel then
        return config.TargetTextChannel
    end

    local channels = TextChatService:FindFirstChild("TextChannels")
    if channels then
        return channels:FindFirstChild("RBXGeneral")
    end

    return nil
end

local function ExecuteCommand(command)
    local channel = GetChannel()

    if not channel then
        status.Text = "ERRO: CANAL DE CHAT NÃO ENCONTRADO"
        status.TextColor3 = Color3.fromRGB(255, 90, 90)
        return
    end

    task.spawn(function()
        for i = 1, command.Repetitions do
            local success = pcall(function()
                channel:SendAsync(command.Message)
            end)

            if not success then
                status.Text = "ERRO AO SOLICITAR ENVIO"
                status.TextColor3 = Color3.fromRGB(255, 90, 90)
                return
            end
        end

        status.Text = "STATUS: ENVIO SOLICITADO"
        status.TextColor3 = GREEN
    end)
end

